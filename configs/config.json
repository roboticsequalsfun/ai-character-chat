{
  "stt": {
    "model": "tiny"
  },

  "tts": {
    "model_path": "path/to/tts/model"
  },

  "tts_training": {
    "batch_size": 32,
    "eval_batch_size": 16,
    "num_loader_workers": 4,
    "num_eval_loader_workers": 4,
    "run_eval": true,
    "test_delay_epochs": -1,
    "epochs": 1000,
    "text_cleaner": "phoneme_cleaners",
    "use_phonemes": true,
    "phoneme_language": "en-us",
    "print_step": 25,
    "print_eval": false,
    "mixed_precision": true,
    "model_name": "glow_tts",
    "speaker_id": 0
  },

  "audio": {
    "sample_rate": 44100,
    "silence_duration": 0.01,
    "silence_threshold": 0.5,
    "min_record_time": 2.0,
    "channels": 1,
    "block_size": 1024,
    "device_index": 1
  },

  "llm": {
    "character_name": "Peppa Pig",
    "model": "Llama-4-Scout-17B-16E-Instruct-UD-Q2_K_XL.gguf",
    "n_gpu_layers": -1,
    "low_vram": false,
    "max_tokens": 60,
    "temperature": 0.7,
    "top_p": 0.9,
    "stop": null
  },

  "dataset_builder": {
    "chunk_audio": {
      "chunk_duration": 5.0,
      "min_chunk_duration": 2.0,
      "padding": {
        "enabled": true,
        "start": 0.5,
        "end": 0.5
      }
    },

    "diarization": {
      "max_silence_ms": 500,
      "audio_file": "Trump_WEF_2018.mp3",
      "enabled": true,
      "punctuate": true
    },

    "cache_run": true
  }
}
